{
  "name": "@atlas/api-types",
  "version": "0.0.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "targets": {
      "generate-types": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^openapi:generate"
        ],
        "cache": true,
        "inputs": [
          "{workspaceRoot}/projects/backend/openapi.json"
        ],
        "outputs": [
          "{projectRoot}/src/api.d.ts"
        ],
        "options": {
          "command": "bun openapi-typescript ../../projects/backend/openapi.json -o src/api.d.ts",
          "cwd": "packages/api-types"
        }
      }
    }
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
