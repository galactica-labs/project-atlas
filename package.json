  "license": "MIT",
  "lint-staged": {
    "projects/backend/**/*.{ts,js,json}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "projects/frontend/**/*.{ts,tsx,js,jsx,json}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "packages/**/*.{ts,tsx,js,jsx,json}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "tools/**/*.{ts,js,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "private": true,
  "scripts": {
    "prepare": "husky"
  },
  "workspaces": [
    "packages/*",
    "projects/*",
    "python/*",
    "tools/*"
  ],
  "dependencies": {}
