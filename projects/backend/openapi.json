  "info": {
    "title": "Porject ATLAS Backend API",
    "description": "The API used to power the Project ATLAS' backend.",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ReasoningCandidateDto": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "confidence",
          "notes"
        ]
      },
      "ImportDocumentResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "number"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "fileName",
          "contentType",
          "sizeBytes",
          "createdAt"
        ]
      },
      "ImportItemResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "batchId": {
            "type": "string"
          },
          "ingressKey": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "rawPayload": {
            "type": "object",
            "additionalProperties": true
          },
          "normalizedName": {
            "type": "object",
            "nullable": true
          },
          "category": {
            "type": "object",
            "nullable": true
          },
          "confidence": {
            "type": "object",
            "nullable": true
          },
          "reasoning": {
            "type": "object",
            "nullable": true
          },
          "candidates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReasoningCandidateDto"
            }
          },
          "technicianDecision": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "edited",
              "needs-doc"
            ]
          },
          "technicianNotes": {
            "type": "object",
            "nullable": true
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImportDocumentResponseDto"
            }
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "batchId",
          "ingressKey",
          "sku",
          "vendor",
          "quantity",
          "rawPayload",
          "candidates",
          "technicianDecision",
          "documents",
          "createdAt",
          "updatedAt"
        ]
      },
      "ImportBatchResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "ingress-controller"
            ]
          },
          "sourceLabel": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ingested",
              "matched",
              "reviewed",
              "committed"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImportItemResponseDto"
            }
          }
        },
        "required": [
          "id",
          "source",
          "sourceLabel",
          "status",
          "createdAt",
          "updatedAt",
          "items"
        ]
      },
      "ImportItemReviewDto": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "format": "uuid"
          },
          "technicianDecision": {
            "type": "string",
            "enum": [
              "confirmed",
              "edited",
              "needs-doc"
            ]
          },
          "technicianNotes": {
            "type": "string"
          },
          "normalizedName": {
            "type": "string"
          },
          "category": {
            "type": "string"
          }
        },
        "required": [
          "itemId",
          "technicianDecision"
        ]
      },
      "ReviewImportBatchDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImportItemReviewDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "ComponentCatalogEntryResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "importItemId": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          },
          "normalizedName": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          },
          "technicianDecision": {
            "type": "string",
            "enum": [
              "pending",
              "confirmed",
              "edited",
              "needs-doc"
            ]
          },
          "documentation": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImportDocumentResponseDto"
            }
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "importItemId",
          "sku",
          "vendor",
          "normalizedName",
          "category",
          "confidence",
          "technicianDecision",
          "documentation",
          "createdAt"
        ]
      },
      "CommitImportBatchResponseDto": {
        "type": "object",
        "properties": {
          "batch": {
            "$ref": "#/components/schemas/ImportBatchResponseDto"
          },
          "catalogEntries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ComponentCatalogEntryResponseDto"
            }
          }
        },
        "required": [
          "batch",
          "catalogEntries"
        ]
      },
      "AssetDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "asset_type": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "criticality": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "location": {
            "type": "object",
            "additionalProperties": true
          },
          "manual_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "asset_type",
          "model",
          "criticality",
          "location",
          "manual_ids"
        ]
      },
      "AssetListDto": {
        "type": "object",
        "properties": {
          "assets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AssetDto"
            }
          }
        },
        "required": [
          "assets"
        ]
      },
      "BlastRadiusNodeDto": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "hops_from_source": {
            "type": "number"
          },
          "estimated_impact_at": {
            "type": "string"
          },
          "impact_type": {
            "type": "string",
            "enum": [
              "loss_of_cooling",
              "loss_of_power",
              "loss_of_capacity",
              "degraded"
            ]
          }
        },
        "required": [
          "asset_id",
          "hops_from_source",
          "estimated_impact_at",
          "impact_type"
        ]
      },
      "BlastRadiusDto": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BlastRadiusNodeDto"
            }
          }
        },
        "required": [
          "asset_id",
          "nodes"
        ]
      },
      "DependenciesDto": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "asset_id",
          "dependencies",
          "dependents"
        ]
      },
      "SimulateIncidentDto": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "example": "CHILLER-A-03"
          },
          "metric": {
            "type": "string",
            "example": "supply_temperature",
            "default": "supply_temperature"
          }
        },
        "required": [
          "asset_id",
          "metric"
        ]
      },
      "AnomalySignalDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "asset_id": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "current_value": {
            "type": "number"
          },
          "baseline_mean": {
            "type": "number"
          },
          "baseline_std": {
            "type": "number"
          },
          "z_score": {
            "type": "number"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warn",
              "critical"
            ]
          },
          "detected_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "asset_id",
          "metric",
          "current_value",
          "baseline_mean",
          "baseline_std",
          "z_score",
          "severity",
          "detected_at"
        ]
      },
      "QuantileForecastDto": {
        "type": "object",
        "properties": {
          "metric": {
            "type": "string"
          },
          "horizon_seconds": {
            "type": "number"
          },
          "q05": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "q50": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "q95": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "threshold": {
            "type": "number"
          },
          "threshold_direction": {
            "type": "string",
            "enum": [
              "above",
              "below"
            ]
          },
          "time_to_q50_crosses_threshold": {
            "type": "number",
            "nullable": true
          },
          "time_to_q95_crosses_threshold": {
            "type": "number",
            "nullable": true
          },
          "uncertainty_band_width": {
            "type": "number"
          }
        },
        "required": [
          "metric",
          "horizon_seconds",
          "q05",
          "q50",
