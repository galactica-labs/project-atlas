{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@atlas/api-client": ["../../packages/api-client/src/index.ts"],
      "@atlas/api-types": ["../../packages/api-types/src/index.ts"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../packages/api-types"
    },
    {
      "path": "../../packages/api-client"
    }
  ]
}
